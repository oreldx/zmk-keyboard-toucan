#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define SPEC  1
#define NAV  2
#define MOUSE  3
#define BASE_MAC 4
#define SPEC_MAC 5
#define NAV_MAC 6
#define MOUSE_MAC 7
#define DEBUG 8

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            hold-trigger-on-release;
        };

        td_ctrl_opt_globe: tap_dance_ctrl_opt_globe {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LCTRL>, <&kp LALT>, <&kp GLOBE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &lt 3 ESC     &kp Q       &kp W    &kp E     &kp R      &kp T                  &kp Y      &kp U      &kp I        &kp O     &kp P         &kp DEL
                &kp TAB     &kp A       &kp S    &lt 2 D     &kp F      &kp G                  &kp H      &kp J      &lt 2 K      &kp L     &kp SEMI      &kp FSLH
                &kp LGUI    &kp LALT    &kp Z    &kp X       &kp C      &kp V                  &kp B      &kp N      &tog 1       &kp M     &kp COMMA     &kp DOT
                                                &kp LCTRL   &kp LSHFT   &kp SPACE            &kp BSPC   &kp RET   &kp LALT
            >;
        };

        spec {
            display-name = "SPEC";
            bindings = <
                &trans      &kp GRAVE      &kp N2     &kp N7       &kp LBKT       &kp PSCRN                 &kp N8       &kp C_VOL_DN     &kp C_MUTE     &kp C_VOL_UP          &trans        &trans
                &trans      &kp LBKT       &lt 2 N1   &kp N3       &kp N4         &kp SQT                   &kp N6       &kp N5           &lt 2 MINUS    &kp EQUAL             &kp RALT      &trans
                &trans      &kp RALT       &kp SQT    &kp N9       &kp N0         &trans                    &kp RBKT     &kp NUBS         &tog 1         &kp KP_MULTIPLY       &tog 3        &trans
                                                                &trans       &trans       &trans            &trans         &trans       &trans
            >;
        };
        
        nav {
            display-name = "NUM";
            bindings = <
                &trans      &trans         &kp KP_N7      &kp KP_N8       &kp KP_N9       &trans                      &kp F4      &kp HOME      &kp UP         &kp END      &trans      &trans
                &trans      &kp KP_N0      &kp KP_N4      &kp KP_N5       &kp KP_N6       &kp KP_NUM                  &kp F5      &kp LEFT      &kp DOWN       &kp RIGHT    &trans      &trans
                &trans      &trans         &kp KP_N1      &kp KP_N2       &kp KP_N3       &trans                      &kp F11     &kp F12       &kp F1         &kp F2       &kp F10     &trans
                                                                        &trans      &trans     &trans              &trans      &trans     &trans
            >;
        };

        mouse {
            display-name = "NAV";
            bindings = <
                &trans    &trans   &trans     &trans  &trans  &tog 4           &trans  &trans &trans &trans &trans &trans
                &trans    &trans   &trans     &trans  &trans  &trans           &trans  &trans &trans &trans &trans &bt BT_CLR
                &trans    &trans   &trans     &trans  &trans  &trans           &trans  &trans &trans &trans &trans &bt BT_NXT
                                         &mkp RCLK &mkp LCLK &mkp MCLK       &trans &trans &trans
            >;
        };

        base_mac {
            display-name = "BASE_MAC";
            bindings = <
                &lt 7 ESC   &kp Q       &kp W    &kp E     &kp R      &kp T                  &kp Y      &kp U      &kp I       &kp O     &kp P         &kp DEL
                &kp TAB     &kp A       &kp S    &lt 6 D     &kp F    &kp G                  &kp H      &kp J      &lt 6 K     &kp L     &kp SEMI      &kp N8
                &kp LCTRL   &kp LALT    &kp Z    &kp X     &kp C      &kp V                  &kp B      &kp N      &tog 5      &kp M     &kp COMMA     &kp DOT
                                                &kp LGUI    &kp LSHFT   &kp SPACE         &kp BSPC   &kp RET   &td_ctrl_opt_globe
            >;
        };

        spec_mac {
            display-name = "SPEC_MAC";
            bindings = <
                &trans      &kp NUHS      &kp N2     &kp N7       &kp LBKT       &kp PSCRN                     &kp PLUS         &kp C_VOL_DN     &kp C_MUTE     &kp C_VOL_UP          &trans        &trans
                &trans      &kp NUBS      &lt 6 N1   &kp N3       &kp N4         &kp BSLH                      &kp EQUAL        &kp N5           &lt 6 MINUS    &kp FSLH              &trans        &trans
                &trans      &trans        &kp SQT    &kp N9       &kp N0         &trans                        &kp RBKT         &kp GRAVE        &tog 5         &kp KP_MULTIPLY       &trans        &trans
                                                              &trans       &trans       &trans              &trans         &trans       &trans
            >;
        };

        nav_mac {
            display-name = "NUM_MAC";
            bindings = <
                &trans      &trans         &kp KP_N7      &kp KP_N8       &kp KP_N9       &trans                      &kp F4      &kp HOME      &kp UP         &kp END      &trans      &trans
                &trans      &kp KP_N0      &kp KP_N4      &kp KP_N5       &kp KP_N6       &kp KP_NUM                  &kp F5      &kp LEFT      &kp DOWN       &kp RIGHT    &trans      &trans
                &trans      &trans         &kp KP_N1      &kp KP_N2       &kp KP_N3       &trans                      &kp F11     &kp F12       &kp F1         &kp F2       &kp F10     &trans
                                                                        &trans      &trans     &trans              &trans      &trans     &trans
            >;
        };

        mouse_mac {
            display-name = "NAV_MAC";
            bindings = <
                &trans    &trans   &trans     &trans  &trans  &tog 4           &trans  &trans &trans &trans &trans &trans
                &trans    &trans   &trans     &trans  &trans  &trans           &trans  &trans &trans &trans &trans &bt BT_CLR
                &trans    &trans   &trans     &trans  &trans  &trans           &trans  &trans &trans &trans &trans &bt BT_NXT
                                         &mkp RCLK &mkp LCLK &mkp MCLK       &trans &trans &trans
            >;
        };

        debug {
            display-name = "DEBUG";
            bindings = <
                &trans   &trans  &trans  &trans  &trans  &trans           &trans  &trans &trans &trans &trans &trans
                &trans   &trans  &trans  &trans  &trans  &trans           &trans  &trans &trans &trans &trans &trans
                &trans   &trans  &trans  &trans  &trans  &trans           &trans  &trans &trans &trans &trans &trans
                                     &trans      &trans      &trans    &trans      &trans      &trans
            >;
        };

        extra_3 {
                status = "reserved";
        };
    };
};